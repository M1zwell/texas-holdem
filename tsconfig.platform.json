{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["platform/engine/**/*.ts", "platform/server/**/*.ts", "platform/shared/**/*.ts"],
  "exclude": ["platform/**/__tests__/**"]
}
