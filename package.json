{
  "name": "texas-holdem-house",
  "version": "0.2.0",
  "description": "Jub Poker — online multiplayer Hold'em, Baccarat, and Tic-Tac-Toe on the texas-holdem-house engine",
  "main": "dist/src/index.js",
  "keywords": [
    "texas",
    "texas hold'em",
    "game",
    "game engine",
    "multiplayer"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "clean": "rm -rf dist platform/web/dist",
    "lint": "tslint --project .",
    "purge": "rm -rf package-lock.json node_modules && npm run clean",
    "prepublishOnly": "npm run clean && npm run compile",
    "prettier": "prettier --config .prettierrc --write '**/*'",
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch platform/server/index.ts\" \"vite --config platform/web/vite.config.ts\"",
    "dev:server": "tsx watch platform/server/index.ts",
    "dev:web": "vite --config platform/web/vite.config.ts",
    "build": "vite build --config platform/web/vite.config.ts",
    "start": "tsx platform/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:cf": "bash scripts/cf-deploy.sh"
  },
  "author": "themez",
  "dependencies": {
    "@supabase/supabase-js": "^2.113.0",
    "cors": "^2.8.5",
    "debug": "^4.1.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.11",
    "node-texas-evaluator": "^0.1.1",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "source-map-support": "0.5.9",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.4",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash": "^4.14.118",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "husky": "1.2.0",
    "prettier": "^2.8.8",
    "pretty-quick": "^3.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0",
    "socket.io-client": "^4.8.1",
    "tslint": "5.11.0",
    "tslint-config-prettier": "1.17.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8",
    "wrangler": "^4.128.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  }
}
